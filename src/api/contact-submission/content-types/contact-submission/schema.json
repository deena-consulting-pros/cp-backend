{
  "kind": "collectionType",
  "collectionName": "contact_submissions",
  "info": {
    "singularName": "contact-submission",
    "pluralName": "contact-submissions",
    "displayName": "Contact Submission"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "fullName": {
      "type": "string",
      "required": true
    },
    "businessEmail": {
      "type": "email",
      "required": true
    },
    "phoneNumber": {
      "type": "string"
    },
    "companyWebsite": {
      "type": "string"
    },
    "serviceInterest": {
      "type": "string"
    },
    "message": {
      "type": "text"
    },
    "sourcePage": {
      "type": "string"
    },
    "submitStatus": {
      "type": "enumeration",
      "enum": [
        "new",
        "reviewed",
        "replied",
        "spam"
      ]
    },
    "submittedAt": {
      "type": "datetime"
    }
  }
}
