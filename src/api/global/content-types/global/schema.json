{
  "kind": "singleType",
  "collectionName": "globals",
  "info": {
    "singularName": "global",
    "pluralName": "globals",
    "displayName": "Global",
    "description": "Define global settings"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "siteName": {
      "type": "string",
      "required": true
    },
    "favicon": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos"
      ]
    },
    "siteDescription": {
      "type": "text",
      "required": true
    },
    "siteLogo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "defaultOgImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "siteSlogan": {
      "type": "string"
    },
    "supportEmail": {
      "type": "email"
    },
    "supportPhone": {
      "type": "string"
    },
    "siteLanguage": {
      "type": "string"
    },
    "twitterSite": {
      "type": "string"
    },
    "defaultCurrency": {
      "type": "string"
    },
    "addressCountryCode": {
      "type": "string"
    },
    "sameAs": {
      "type": "component",
      "component": "shared.social-link",
      "repeatable": true
    },
    "defaultSeo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    },
    "businessAddress": {
      "type": "component",
      "component": "shared.address",
      "repeatable": false
    },
    "navbar": {
      "type": "component",
      "component": "shared.navbar",
      "repeatable": false
    },
    "footer": {
      "type": "component",
      "component": "layout.footer",
      "repeatable": false
    },
    "whatsappNumber": {
      "type": "string"
    },
    "businessHours": {
      "type": "string"
    }
  }
}
