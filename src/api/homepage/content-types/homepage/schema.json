{
  "kind": "singleType",
  "collectionName": "homepages",
  "info": {
    "singularName": "homepage",
    "pluralName": "homepages",
    "displayName": "Homepage"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "hero": {
      "type": "component",
      "component": "shared.hero",
      "repeatable": false
    },
    "trustedHeading": {
      "type": "component",
      "component": "shared.section-heading",
      "repeatable": false
    },
    "trustedLogos": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::client-logo.client-logo"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    },
    "introHeading": {
      "type": "component",
      "component": "shared.section-heading",
      "repeatable": false
    },
    "introChips": {
      "type": "component",
      "component": "home.chip",
      "repeatable": true
    },
    "servicesHeading": {
      "type": "component",
      "component": "shared.section-heading",
      "repeatable": false
    },
    "featuredServices": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::service.service"
    },
    "whyChooseHeading": {
      "type": "component",
      "component": "shared.section-heading",
      "repeatable": false
    },
    "whyChooseCards": {
      "type": "component",
      "component": "home.feature-card",
      "repeatable": true
    },
    "whyChooseImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "whyChooseBackgroundImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "processHeading": {
      "type": "component",
      "component": "shared.section-heading",
      "repeatable": false
    },
    "processSteps": {
      "type": "component",
      "component": "home.process-step",
      "repeatable": true
    },
    "portfolioHeading": {
      "type": "component",
      "component": "shared.section-heading",
      "repeatable": false
    },
    "portfolioItems": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::portfolio-item.portfolio-item"
    },
    "portfolioButton": {
      "type": "component",
      "component": "shared.link",
      "repeatable": false
    },
    "testimonialsHeading": {
      "type": "component",
      "component": "shared.section-heading",
      "repeatable": false
    },
    "testimonials": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::testimonial.testimonial"
    },
    "faqHeading": {
      "type": "component",
      "component": "shared.section-heading",
      "repeatable": false
    },
    "faqSection": {
      "type": "component",
      "component": "shared.faq-section",
      "repeatable": true
    },
    "finalCta": {
      "type": "component",
      "component": "shared.cta-block",
      "repeatable": false
    }
  }
}
