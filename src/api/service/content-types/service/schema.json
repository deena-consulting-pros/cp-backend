{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "Service"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "shortDescription": {
      "type": "text"
    },
    "description": {
      "type": "blocks"
    },
    "iconKey": {
      "type": "component",
      "component": "shared.icon-key",
      "repeatable": false
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "order": {
      "type": "integer"
    },
    "isFeatured": {
      "type": "boolean"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    },
    "showcaseEyebrow": {
      "type": "string"
    },
    "showcaseTitle": {
      "type": "string"
    },
    "showcaseDescription": {
      "type": "text"
    },
    "showcaseFeatures": {
      "type": "component",
      "component": "shared.features-text",
      "repeatable": true
    },
    "showcaseButton": {
      "type": "component",
      "component": "shared.link",
      "repeatable": false
    },
    "serviceDetails": {
      "type": "component",
      "component": "services.service-details",
      "repeatable": false
    },
    "serviceCta": {
      "type": "component",
      "component": "shared.cta-block",
      "repeatable": false
    }
  }
}
